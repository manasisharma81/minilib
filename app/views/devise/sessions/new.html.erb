<h1>Sign in</h1>

<form action="/users/sign_in" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <div>
    <label for="email_box">Email</label>
    <input type="email" id="email_box" name="user[email]" value="<%= resource.email %>">
  </div>

  <div>
    <label for="password_box">Password</label>
    <input type="password" id="password_box" name="user[password]">
  </div>

  <div>
    <input type="checkbox" id="remember_me_box" name="user[remember_me]" value="1">
    <label for="remember_me_box">Remember me</label>
  </div>

  <button type="submit">Sign in</button>
</form>

<p>
  <a href="/users/sign_up">Sign up</a>
</p>
