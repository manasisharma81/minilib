<article class="profile-card">
  <header>
    <% if @user.profile_picture.present? %>
      <img src="<%= @user.profile_picture %>" alt="<%= @user.username %> profile picture" class="profile-avatar">
    <% else %>
      <div class="profile-avatar-placeholder">
        <%= @user.username.first.upcase %>
      </div>
    <% end %>

    <h1><%= @user.username %></h1>
    <p class="muted-text"><%= @user.email %></p>

    <% if @user.bio.present? %>
      <p><%= @user.bio %></p>
    <% end %>
  </header>

  <p class="profile-actions">
    <a href="/edit_my_profile" role="button">Edit profile</a>
    <a href="/borrow_requests" role="button" class="secondary">Borrow requests</a>
  </p>
</article>

<article>
  <header>
    <h2>My books</h2>
    <p class="table-note">
      <a href="/search_books" role="button">Search books</a>
      <% if @user.user_books.empty? %>
        <span class="muted-text">Your shelf is empty until you add your first book.</span>
      <% end %>
    </p>
  </header>

  <% if @user.user_books.any? %>
    <table>
      <thead>
        <tr>
          <th>Book</th>
          <th>Authors</th>
        </tr>
      </thead>
      <tbody>
        <% @user.user_books.each do |user_book| %>
          <% book = user_book.book %>
          <tr>
            <td><a href="/books/<%= book.id %>"><%= book.title %></a></td>
            <td><%= book.authors %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted-text">Your shelf is empty. Search for a book to add your first one.</p>
  <% end %>
</article>
