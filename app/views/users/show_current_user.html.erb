<h1>My profile</h1>

<dl>
  <dt>Username</dt>
  <dd><%= @user.username %></dd>

  <dt>Email</dt>
  <dd><%= @user.email %></dd>

  <% if @user.bio.present? %>
    <dt>Bio</dt>
    <dd><%= @user.bio %></dd>
  <% end %>

  <dt>Profile picture</dt>
  <dd>
    <% if @user.profile_picture.present? %>
      <img src="<%= @user.profile_picture %>" alt="<%= @user.username %> profile picture" style="width: 150px; height: 150px; object-fit: cover;">
    <% else %>
      No profile picture yet.
    <% end %>
  </dd>
</dl>

<p>
  <a href="/edit_my_profile">Edit profile</a>
  <a href="/borrow_requests">Borrow requests</a>
</p>

<h2>My books</h2>

<p>
  <a href="/insert_book_form">Add a book</a>
</p>

<% if @user.books.any? %>
  <ul>
    <% @user.books.each do |book| %>
      <li>
        <a href="/books/<%= book.id %>"><%= book.title %></a>
        by <%= book.author %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No books yet.</p>
<% end %>
