<h1>My books</h1>

<p>
  <a href="/search_books">Add a book</a>
</p>

<% if @user_books.any? %>
  <ul>
    <% @user_books.each do |user_book| %>
      <% book = user_book.book %>
      <li>
        <% if book.cover_image_url.present? %>
          <img src="<%= book.cover_image_url %>" alt="<%= book.title %> cover" style="width: 75px; height: 110px; object-fit: cover;">
        <% end %>

        <a href="/books/<%= book.id %>"><%= book.title %></a>

        <% if book.authors.present? %>
          by <%= book.authors %>
        <% end %>

        <a href="/modify_book/<%= user_book.id %>">Edit my ownership/review</a>
        <a href="/delete_book/<%= user_book.id %>">Remove from my books</a>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No books yet.</p>
<% end %>

<p>
  <a href="/my_profile">Back to profile</a>
</p>
