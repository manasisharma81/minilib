<article>
  <header>
    <h1>My books</h1>
    <p class="table-note">
      <a href="/search_books">Search books</a>
      <span class="muted-text">Find something new for your shelf.</span>
    </p>
  </header>

  <% if @user_books.any? %>
    <table>
      <thead>
        <tr>
          <th>Cover</th>
          <th>Book</th>
          <th>Loan status</th>
          <th>My rating</th>
          <th>My review</th>
          <th>Review actions</th>
          <th>Ownership actions</th>
        </tr>
      </thead>
      <tbody>
        <% @user_books.each do |user_book| %>
          <% book = user_book.book %>
          <tr>
            <td>
              <% if book.cover_image_url.present? %>
                <img src="<%= book.cover_image_url %>" alt="<%= book.title %> cover" style="width: 75px; height: 110px; object-fit: cover;">
              <% end %>
            </td>
            <td>
              <a href="/books/<%= book.id %>"><%= book.title %></a>
              <% if book.authors.present? %>
                <br>
                <small><%= book.authors %></small>
              <% end %>
            </td>
            <td>
              <% if user_book.availability_status.blank? %>
                <span class="muted-text">Not specified</span>
              <% elsif user_book.availability_status == "available" %>
                Available for loan
              <% elsif user_book.availability_status == "rented_out" %>
                Rented out
              <% end %>
            </td>
            <td>
              <% if user_book.rating.present? %>
                <% filled_stars = "★" * user_book.rating %>
                <% empty_stars = "☆" * (5 - user_book.rating) %>
                <span><%= filled_stars + empty_stars %></span>
                <br>
                <small class="muted-text"><%= user_book.rating %>/5</small>
              <% else %>
                <span class="muted-text">Not rated yet</span>
              <% end %>
            </td>
            <td>
              <% if user_book.review.present? %>
                <%= truncate(user_book.review, length: 120) %>
              <% else %>
                <span class="muted-text">No review yet</span>
              <% end %>
            </td>
            <td>
              <div class="compact-table-actions">
                <a href="/modify_book/<%= user_book.id %>" role="button">Edit review</a>
              </div>
            </td>
            <td>
              <div class="compact-table-actions">
                <a href="/delete_book/<%= user_book.id %>" role="button" class="secondary">Remove</a>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <article>
      <p>Your shelf is empty. Search for a book to add your first one.</p>
    </article>
  <% end %>
</article>

<p>
  <a href="/my_profile">Back to profile</a>
</p>
