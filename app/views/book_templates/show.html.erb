<h1><%= @book.title %></h1>

<dl>
  <% if @book.authors.present? %>
    <dt>Authors</dt>
    <dd><%= @book.authors %></dd>
  <% end %>

  <% if @book.cover_image_url.present? %>
    <dt>Cover image</dt>
    <dd>
      <img src="<%= @book.cover_image_url %>" alt="<%= @book.title %> cover" style="width: 150px; height: 220px; object-fit: cover;">
    </dd>
  <% end %>

  <% if @book.publisher.present? %>
    <dt>Publisher</dt>
    <dd><%= @book.publisher %></dd>
  <% end %>

  <% if @book.published_date.present? %>
    <dt>Published date</dt>
    <dd><%= @book.published_date %></dd>
  <% end %>

  <% if @book.isbn_10.present? %>
    <dt>ISBN 10</dt>
    <dd><%= @book.isbn_10 %></dd>
  <% end %>

  <% if @book.isbn_13.present? %>
    <dt>ISBN 13</dt>
    <dd><%= @book.isbn_13 %></dd>
  <% end %>

  <% if @book.description.present? %>
    <dt>Description</dt>
    <dd><%= @book.description %></dd>
  <% end %>
</dl>

<h2>Owners</h2>

<% if @book.user_books.any? %>
  <ul>
    <% @book.user_books.each do |user_book| %>
      <% owner = user_book.user %>
      <li>
        <a href="/users/<%= owner.id %>"><%= owner.username %></a>

        <% if owner.id != current_user.id %>
          <form action="/create_borrow_request/<%= @book.id %>/<%= owner.id %>" method="post">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

            <div>
              <label for="message_box_<%= owner.id %>">Message</label>
              <textarea id="message_box_<%= owner.id %>" name="query_message"></textarea>
            </div>

            <button type="submit">Request to borrow from <%= owner.username %></button>
          </form>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No owners yet.</p>
<% end %>

<h2>Reviews</h2>

<% if @book.user_books.any? %>
  <ul>
    <% @book.user_books.each do |user_book| %>
      <% if user_book.rating.present? || user_book.review.present? %>
        <li>
          <a href="/users/<%= user_book.user.id %>"><%= user_book.user.username %></a>

          <% if user_book.rating.present? %>
            rated this <%= user_book.rating %>/5
          <% end %>

          <% if user_book.review.present? %>
            <p><%= user_book.review %></p>
          <% end %>
        </li>
      <% end %>
    <% end %>
  </ul>
<% else %>
  <p>No reviews yet.</p>
<% end %>

<p>
  <% if @current_user_book != nil %>
    <a href="/modify_book/<%= @current_user_book.id %>">Edit my ownership/review</a>
    <a href="/delete_book/<%= @current_user_book.id %>">Remove from my books</a>
  <% end %>

  <a href="/books">Back to my books</a>
</p>
