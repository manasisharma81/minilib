<h1><%= @book.title %></h1>

<dl>
  <dt>Author</dt>
  <dd><%= @book.author %></dd>

  <% if @book.cover_image_url.present? %>
    <dt>Cover image</dt>
    <dd>
      <img src="<%= @book.cover_image_url %>" alt="<%= @book.title %> cover" style="width: 150px; height: 220px; object-fit: cover;">
    </dd>
  <% end %>

  <% if @book.description.present? %>
    <dt>Description</dt>
    <dd><%= @book.description %></dd>
  <% end %>

  <% if @book.rating.present? %>
    <dt>Rating</dt>
    <dd><%= @book.rating %></dd>
  <% end %>

  <% if @book.review.present? %>
    <dt>Review</dt>
    <dd><%= @book.review %></dd>
  <% end %>
</dl>

<p>
  <a href="/modify_book/<%= @book.id %>">Edit book</a>
  <a href="/delete_book/<%= @book.id %>">Delete book</a>
  <a href="/books">Back to books</a>
</p>
